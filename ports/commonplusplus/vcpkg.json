{
  "name": "commonplusplus",
  "version": "1.0.0",
  "description": "Commonly used Std Extensions Library for C++",
  "homepage": "https://git.cranberry-box.com/lewisb3/commonplusplus",
  "license": "MIT",
  "dependencies": [
    "fmt",
    "glm",
    "spdlog",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "reflect": {
      "description": "reflect-cpp glue: glm, String16 and Bitset reflectors, toml/msgpack",
      "dependencies": [
        {
          "name": "reflectcpp",
          "features": [
            "msgpack",
            "toml"
          ]
        }
      ]
    }
  }
}
